# Copie para .env e preencha. Chaves só no servidor (pasta api/).
APIFY_TOKEN=
GEMINI_API_KEY=
# Opcional: modelos do Gemini (análise e conversa sobre vídeos; analista de oportunidades).
MODELO_ANALISE=gemini-3.5-flash
MODELO_OPORTUNIDADES=gemini-3.5-flash
OPORTUNIDADES_POR_DIA=10
MENSAGENS_CHAT_POR_DIA=60
TYPESAFE_API_KEY=
YOUTUBE_API_KEY=

# Asaas (assinaturas). Comece no Sandbox: chave $aact_hmlg_… com ASAAS_AMBIENTE=sandbox.
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox
# token que você inventa (32+ caracteres, sem espaço) e cola no webhook do Asaas
ASAAS_WEBHOOK_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_DB_URL=
# só no servidor (Render): as capas vão para o Supabase Storage. Sem ela, ficam em data/capas
SUPABASE_SECRET_KEY=
DONOS=
